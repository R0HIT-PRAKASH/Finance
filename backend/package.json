{
  "name": "fintrack-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node-pg-migrate up --migrations-dir src/migrations --database-url postgresql://fintrack:fintrack@db:5432/fintrack",
    "migrate:down": "node-pg-migrate down --migrations-dir src/migrations --database-url postgresql://fintrack:fintrack@db:5432/fintrack",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "zod": "^4.5.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "node-pg-migrate": "^7.x.x",
    "yahoo-finance2": "^3.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.5",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5",
    "vitest": "^5.0.0"
  }
}
